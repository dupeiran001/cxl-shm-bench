# Editor noise
*.swp
*~

# PARSEC build output (regenerated by `parsecmgmt -a build`)
**/inst/
**/obj/
**/run/
**/autom4te.cache/

# NOTE: pkgs/libs/ssl/src/Makefile is deliberately TRACKED (not ignored):
# parsecmgmt cannot drive openssl's ./config, so the artifact ships the
# pre-Configured Makefile; setup.sh rewrites its baked INSTALLTOP prefix to
# the current tree at build time. Do not re-add it to this ignore list —
# without it, parsec.ssl (a dedup dependency) cannot build from a fresh clone.

# PARSEC input data: extracted per-package inputs are regenerated (not
# tracked), and downloaded tarballs (incl. an optional offline copy under
# input-archive/) are never committed — setup.sh fetches them from the
# archival mirror (doi:10.5281/zenodo.21314344), SHA-256-verified.
**/inputs/
*.tar.gz
*.tar
*.tgz

# Ephemeral runtime logs (parsecmgmt writes fresh here each run)
/log/

# Runtime trace files
**/traces.*

# Python / tooling caches
__pycache__/
