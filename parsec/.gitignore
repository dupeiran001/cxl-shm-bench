# Editor noise
*.swp
*~

# PARSEC build output (regenerated by `parsecmgmt -a build`)
**/inst/
**/obj/
**/run/
**/autom4te.cache/

# Openssl Configure-generated Makefile (template at Makefile.org is tracked;
# `./config` or `./Configure` regenerates Makefile with local build paths)
pkgs/libs/ssl/src/Makefile

# PARSEC input data: extracted per-package inputs are regenerated (not
# tracked), and downloaded tarballs (incl. an optional offline copy under
# input-archive/) are never committed — setup.sh fetches them from the
# archival mirror (doi:10.5281/zenodo.21314344), SHA-256-verified.
**/inputs/
*.tar.gz
*.tar
*.tgz

# Ephemeral runtime logs (parsecmgmt writes fresh here each run)
/log/

# Runtime trace files
**/traces.*

# Python / tooling caches
__pycache__/
